# Contact form → Google Sheet.
# Copy this file to `.env.local` and fill in the real values.
#
# Both are SERVER-ONLY. Do not prefix them with VITE_ — anything prefixed VITE_
# is inlined into the JavaScript bundle and visible to every visitor.

# The Apps Script web app deployment URL. Must end in /exec (not /dev).
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Must match the API_SECRET script property in the Apps Script project exactly.
# Generate one with:  powershell -c "[guid]::NewGuid().ToString('N')"
FORM_API_SECRET=replace-with-your-generated-secret

# --- SEO / Google Search Console reporting (scripts/seo/gsc-report.mjs) ---
# See CLAUDE.md → "Google Search Console API setup" for how to create these.
# Set ONE of the two GSC_SERVICE_ACCOUNT_* vars below.

# Full contents of the downloaded service-account JSON key, as a single-line
# string. Easiest for CI / scheduled-job environments (no file to manage).
GSC_SERVICE_ACCOUNT_JSON=

# Alternative to the above: a path to the downloaded .json key file. Easiest
# for local runs — put the actual file outside the repo (e.g. ~/secrets/) and
# point this at it. Never commit the key file itself.
GSC_SERVICE_ACCOUNT_KEY_FILE=

# The Search Console property URL as it's registered in Search Console.
# Use "https://treemate.us/" for a URL-prefix property (default assumed by
# the script), or "sc-domain:treemate.us" if the property is domain-scoped.
SITE_URL=https://treemate.us/
