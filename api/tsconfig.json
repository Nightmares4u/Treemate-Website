{
  // Picked up by Vercel's function builder (@vercel/node), which compiles
  // api/*.ts against the nearest tsconfig and does not follow the project
  // references in the root tsconfig.json. Without this it can't see the
  // node type definitions (Buffer, process, node:http).
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts"]
}
